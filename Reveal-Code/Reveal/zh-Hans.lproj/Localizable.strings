"notif_daily_title" = "Reveal";
"notif_daily_body" = "揭晓你今日的经文";

/* Card 1 - John 3:16 */
"card_1_verse" = "神爱世人，甚至将他的独生子赐给他们，叫一切信他的，不至灭亡，反得永生。";
"card_1_question" = "认识神的爱如何改变你今日的生活？";

/* Card 2 - Psalm 23:1 */
"card_2_verse" = "耶和华是我的牧者，我必不至缺乏。";
"card_2_question" = "在你生活的哪些方面，你需要信靠神作为你的牧者？";

/* Card 3 - Philippians 4:13 */
"card_3_verse" = "我靠着那加给我力量的，凡事都能做。";
"card_3_question" = "你正面临什么挑战需要神的力量？";

/* Card 4 - Proverbs 3:5-6 */
"card_4_verse" = "你要专心仰赖耶和华，不可倚靠自己的聪明，在你一切所行的事上都要认定他，他必指引你的路。";
"card_4_question" = "你在哪些地方依靠自己的理解而不是信靠神？";

/* Card 5 - Matthew 6:26 */
"card_5_verse" = "你们看那天上的飞鸟，也不种，也不收，也不积蓄在仓里，你们的天父尚且养活它。你们不比飞鸟贵重得多吗？";
"card_5_question" = "什么忧虑阻止你信靠神的供应？";

/* Card 6 - Isaiah 40:31 */
"card_6_verse" = "但那等候耶和华的必从新得力。他们必如鹰展翅上腾；他们奔跑却不困倦，行走却不疲乏。";
"card_6_question" = "当你感到疲惫时，如何等候耶和华？";

/* Card 7 - Romans 8:28 */
"card_7_verse" = "我们晓得万事都互相效力，叫爱神的人得益处，就是按他旨意被召的人。";
"card_7_question" = "什么困难的情况你可以相信神正在为你成就益处？";

/* Card 8 - Jeremiah 29:11 */
"card_8_verse" = "耶和华说：我知道我向你们所怀的意念是赐平安的意念，不是降灾祸的意念，要叫你们末后有指望。";
"card_8_question" = "知道神对你有美好的计划如何改变你的视角？";

/* Card 9 - Ephesians 2:8-9 */
"card_9_verse" = "你们得救是本乎恩，也因着信；这并不是出于自己，乃是神所赐的；也不是出于行为，免得有人自夸。";
"card_9_question" = "领受救恩为礼物如何改变你对待他人的方式？";

/* Card 10 - Psalm 46:1 */
"card_10_verse" = "神是我们的避难所，是我们的力量，是我们在患难中随时的帮助。";
"card_10_question" = "这周你在哪里需要神作你的避难所？";

/* Card 11 - Joshua 1:9 */
"card_11_verse" = "我岂没有吩咐你吗？你当刚强壮胆！不要惧怕，也不要惊惶，因为你无论往哪里去，耶和华你的神必与你同在。";
"card_11_question" = "你需要勇气迈出哪一步顺服？";

/* Card 12 - 1 Corinthians 13:4 */
"card_12_verse" = "爱是恒久忍耐，又有恩慈；爱是不嫉妒，爱是不自夸，不张狂。";
"card_12_question" = "今天你可以在哪段关系中更多表现忍耐或恩慈？";
